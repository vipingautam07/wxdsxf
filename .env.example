# Docker Compose serves the browser and proxies /api through Nginx.
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Vercel frontend project: set this in Project Settings, then rebuild.
# VITE_API_BASE_URL=https://YOUR-BACKEND-PROJECT.vercel.app/api

# Optional backend override (an absolute path to a validated compressed snapshot).
# WINDSCOPE_SNAPSHOT_PATH=/absolute/path/to/snapshot.json.gz
